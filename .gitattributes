# ==============================================================================
# Normalizacion de finales de linea
# ==============================================================================

# Por defecto: Git normaliza a LF en el repositorio y entrega el final de linea
# nativo en el checkout de cada sistema operativo.
* text=auto

# ==============================================================================
# BINARIOS - nunca deben pasar por conversion de finales de linea
# Sin estas reglas, Git puede corromper el archivo al hacer checkout.
# ==============================================================================

*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.zip     binary
*.gz      binary
*.jar     binary
*.avro    binary
*.parquet binary
*.xlsx    binary
*.docx    binary

# ==============================================================================
# Scripts que requieren un final de linea especifico
# ==============================================================================

*.ps1 text eol=crlf
*.sh  text eol=lf
